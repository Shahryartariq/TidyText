# Copy to .env and fill in. `make dev` and `docker compose` read this file.

# Required in production. Generate one with: make secret
DJANGO_SECRET_KEY=

# 1 for local development only. Never enable in production.
DJANGO_DEBUG=0

# Comma-separated host names the site answers to (Vercel URLs are added automatically).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL, used for canonical links, the sitemap and social cards.
# Example: https://tidytext.vercel.app
SITE_URL=

# Optional hardening. Vercel already redirects HTTP to HTTPS, so leave this off there.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000

# Optional: Google Analytics 4 measurement ID (looks like G-ABC123XYZ9).
# When set, the tag loads on every page and the security policy allows it.
GA_MEASUREMENT_ID=
